{
  "name": "evolution-media",
  "private": true,
  "workspaces": ["apps/web"],
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "npm run dev --workspace @evolution-media/web --",
    "build": "npm run build --workspace @evolution-media/web",
    "start": "npm run start --workspace @evolution-media/web --",
    "typecheck": "npm run typecheck --workspace @evolution-media/web",
    "test:database": "bash tests/database/run.sh",
    "test:auth": "npm run test:auth --workspace @evolution-media/web",
    "test:ingestion": "npm run test:ingestion --workspace @evolution-media/web",
    "check:connection": "node --env-file-if-exists=apps/web/.env.local scripts/check-supabase.mjs"
  }
}
